{
  "expo": {
    "name": "HomeStock",
    "slug": "homestock",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "homestock",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.homestock.app",
      "infoPlist": {
        "NSCameraUsageDescription": "HomeStock uses the camera to photograph items, receipts, and barcodes.",
        "NSPhotoLibraryUsageDescription": "HomeStock attaches photographs from your library to an item.",
        "NFCReaderUsageDescription": "HomeStock reads an NFC tag to open the item or the location that the tag names."
      }
    },
    "android": {
      "package": "com.homestock.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "CAMERA",
        "NFC",
        "VIBRATE"
      ],
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "HomeStock uses the camera to photograph items, receipts, and barcodes."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2563eb",
          "icon": "./assets/notification-icon.png"
        }
      ],
      "react-native-nfc-manager",
      "expo-asset",
      "expo-font",
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/with-release-signing",
      "./plugins/with-arm64-only"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png"
  }
}
