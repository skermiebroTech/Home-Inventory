# HomeStock environment variables
#
# Copy this file to .env and change the values.
#
# NAMING: the application reads the HS_ prefixed name first. If that name is
# not set, it falls back to the bare name shown in the comment. The fallback
# exists because the Unraid Community Applications template uses bare names.
# Prefer the HS_ names in new setups.

# --- Core ---
# Fallback: SECRET_KEY
# Generate a value with: openssl rand -hex 32
HS_SECRET_KEY=CHANGE_ME_TO_RANDOM_STRING

# Fallback: PORT
HS_PORT=7850

# Fallback: LOG_LEVEL
HS_LOG_LEVEL=info

# Fallback: TZ
HS_TZ=Australia/Brisbane

# --- Database ---
# Fallback: DATABASE_URL
HS_DATABASE_URL=postgresql+asyncpg://homestock:homestock@postgres:5432/homestock

# The postgres container reads these. They must agree with HS_DATABASE_URL.
POSTGRES_USER=homestock
POSTGRES_PASSWORD=homestock
POSTGRES_DB=homestock

# --- Storage paths on the host (Docker Compose reads these) ---
#
# These are the directories on your server. On Unraid, point them at the
# appdata share:
#   HOST_DB_DIR=/mnt/user/appdata/home-inventory/db
#   HOST_UPLOADS_DIR=/mnt/user/appdata/home-inventory/uploads
#   HOST_BACKUPS_DIR=/mnt/user/appdata/home-inventory/backups
#   HOST_CONFIG_DIR=/mnt/user/appdata/home-inventory/config
HOST_DB_DIR=../data/db
HOST_UPLOADS_DIR=../data/uploads
HOST_BACKUPS_DIR=../data/backups
HOST_CONFIG_DIR=../data/config

# --- Storage paths (inside the container) ---
# Fallback: DATA_DIR
HS_DATA_DIR=/data
# Fallback: UPLOAD_DIR
HS_UPLOAD_DIR=/data/uploads
# Fallback: BACKUP_DIR
HS_BACKUP_DIR=/data/backups
# Fallback: CONFIG_DIR
HS_CONFIG_DIR=/data/config

# --- Authentication ---
# Fallback: ACCESS_TOKEN_EXPIRE_MINUTES
HS_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Fallback: REFRESH_TOKEN_EXPIRE_DAYS
HS_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Rate limits ---
# The sign in routes are the only ones an unknown caller can reach. Set an
# empty value to turn the limit off.
# Fallback: RATE_LIMIT_AUTH
HS_RATE_LIMIT_AUTH=20/minute

# --- CORS ---
# Comma separated list of allowed origins. Use * for any local network client.
# Fallback: CORS_ORIGINS
HS_CORS_ORIGINS=*

# --- AI (Ollama) ---
#
# THIS SERVER HAS NO GPU. Every model runs on the CPU. The defaults below are
# chosen for speed on a CPU, not for the best accuracy.
#
# Vision model options, fastest first:
#   moondream     1.8B, ~1.7 GB. Roughly 5-20 s per image. The default.
#   llava-phi3    3.8B, ~2.9 GB. Roughly 20-45 s per image. More accurate.
#   llava:7b      7B,   ~4.7 GB. Roughly 60-120 s per image. Too slow.
# Measure on your own hardware. Speed depends on core count and RAM speed.
#
# Point this at an existing Ollama instance if you already run one on Unraid.
# Fallback: OLLAMA_URL
HS_OLLAMA_URL=http://ollama:11434
# Fallback: OLLAMA_VISION_MODEL
HS_OLLAMA_VISION_MODEL=moondream
# Receipt text goes to this text model after Tesseract reads the image.
# A text model on a CPU is much faster than a vision model.
# Fallback: OLLAMA_TEXT_MODEL
HS_OLLAMA_TEXT_MODEL=llama3.2:3b
# Seconds to wait for a model response before the request fails.
# Fallback: OLLAMA_TIMEOUT
HS_OLLAMA_TIMEOUT=300
# Seconds to hold an AI request open before it becomes a background job.
# The client then polls GET /api/ai/jobs/{job_id} for the result.
# Fallback: AI_INLINE_TIMEOUT
HS_AI_INLINE_TIMEOUT=8
# Set to false to disable all AI features.
# Fallback: AI_ENABLED
HS_AI_ENABLED=true

# How many tokens the model may hold. One photograph costs about 1900 of
# them, and a model loads with 2048 unless it is told otherwise, so a smaller
# number here makes every recognition fail with "exceeds the available
# context size". Three photographs of one item need about 6000.
# Fallback: OLLAMA_NUM_CTX
HS_OLLAMA_NUM_CTX=8192

# How long Ollama holds a model in RAM after a request. On a CPU the model
# load costs more time than the inference, so a long value helps a lot.
OLLAMA_KEEP_ALIVE=30m

# --- OCR ---
# Fallback: TESSERACT_CMD
HS_TESSERACT_CMD=/usr/bin/tesseract

# --- Images ---
# Fallback: IMAGE_MAX_DIMENSION
HS_IMAGE_MAX_DIMENSION=2000
# Comma separated thumbnail widths in pixels.
# Fallback: THUMBNAIL_SIZES
HS_THUMBNAIL_SIZES=200,600
# Remove EXIF GPS data from uploads.
# Fallback: STRIP_EXIF_GPS
HS_STRIP_EXIF_GPS=true

# --- Backup ---
# Fallback: BACKUP_ENABLED
HS_BACKUP_ENABLED=false
# Cron expression for the scheduled backup.
# Fallback: BACKUP_CRON
HS_BACKUP_CRON=0 3 * * *
# Number of backups to keep. Older backups are deleted.
# Fallback: BACKUP_RETENTION
HS_BACKUP_RETENTION=7
# Optional rclone remote, for example: b2:my-bucket/homestock
# Fallback: RCLONE_REMOTE
HS_RCLONE_REMOTE=

# --- Advanced ---
# Alembic runs on container start. entrypoint.sh also runs it, so this only
# matters when you start uvicorn yourself.
# Fallback: RUN_MIGRATIONS_ON_START
HS_RUN_MIGRATIONS_ON_START=true

# Serve the uploaded images at /media. The file names hold UUIDs, so a path
# cannot be guessed. Set false if you publish this service on the internet.
# Fallback: SERVE_MEDIA
HS_SERVE_MEDIA=true

# --- Unraid file ownership ---
PUID=99
PGID=100
