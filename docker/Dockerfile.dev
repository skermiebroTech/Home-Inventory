# HomeStock development image.
#
# The code is mounted from the host, so uvicorn reloads on every save. The
# frontend is not built here. Run Vite on the host instead.
#
#   docker compose -f docker/docker-compose.yml \
#                  -f docker/docker-compose.dev.yml up

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HS_DATA_DIR=/data

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg gosu git \
        tesseract-ocr tesseract-ocr-eng \
        libjpeg62-turbo zlib1g libfreetype6; \
    install -d /usr/share/postgresql-common/pgdg; \
    curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
        -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc; \
    echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] \
https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends postgresql-client-16; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY backend/requirements-dev.txt backend/requirements.txt ./backend/
RUN pip install --no-cache-dir -r backend/requirements-dev.txt

EXPOSE 7850
WORKDIR /app/backend

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "7850", "--reload"]
